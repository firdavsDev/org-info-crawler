# Host ports (docker compose and the Vite dev server read these)
API_PORT=8000
FRONTEND_PORT=3000
FRONTEND_DEV_PORT=5173

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/orginfo
BASE_URL=http://localhost:8000
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
ORGINFO_BASE_SEARCH_URL=https://orginfo.uz/uz/search/organizations/
CRAWLER_TIMEOUT_SECONDS=30

# Didox partner API (leave empty to disable /didox/* — it then answers 503)
DIDOX_BASE_URL=
PARTNER_AUTHORIZATION=
